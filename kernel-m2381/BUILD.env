# kernel-m2381 — nura 线料件钉子（内核腿 + 固件，与 pmOS 线通用）
# 内核/固件包由 nura 的 linux-meizu-meizu20 / firmware-meizu-meizu20 线出，
# **pmOS rootfs 与本 armada rootfs 通用同一套料件**——用户到 nura 侧拿最新版，
# 这里只钉当前版参数 + 兼容门禁，不编译不重分发。

# —— 内核腿（r91 / ESP v71 / 7.3.0 stable rebase，2026-10-28 翻钉）——
# nura（九十六）7.3 stable rebase 正式轮（Release r91 上线 Latest）：99 提交零冲突
# 重放到 v7.3（091b0638→c03c1a14）；**内核 release 号 7.3.0-rc6 → 7.3.0**（模块目录
# /usr/lib/modules/7.3.0/；apk 文件名 pkgver 惯性仍带 7.3.0_rc6）。nura 在机 #92
# 回归全绿（真睡 rtcwake resume 0.23s/电源键秒醒/音频/GPU 真空闲钳零/WiFi 5G）。
# ⚠ **钉子先行（用户拍板 2026-10-28 先发 r85 构建）**：我方实机点火回归未跑
# （原协议 = 点火全绿才翻钉），验证转刷后——刷后回归卡 = 三连重启 + 冒烟 +
# uname 期望 #92（release 7.3.0；CI 对的 # 号以实机为准）。回滚 = Release r84
# （0a631c2e 云端盘口径，r84/v65/#85）。
# 料件口径 = Release r91 **CI 全家桶**（CI 与 nura 本地构建同号异字节，不可混搭）：
#   CI apk d2f0c51b…（nura 本地构建 df13faa6，设备日用的是本地对）；
#   CI ESP gz f08139e3 → 裸 472cb934…；
#   腿配对 = CI apk vmlinuz-efi ≡ CI ESP BOOTAA64.EFI = 8b74582b…（逐字节实测）；
#   本地在机对 = 4aad92b3 / 0a102220（nura 设备日实物，留档不为我方 CI 口径）。
KERNEL_APK_VERSION="r91"
KERNEL_RELEASE="7.3.0"
KERNEL_APK_SHA256="d2f0c51bfde3ab3996e1f432a87446fa9e3ff326df9b5a2e6ab54861605aaacf"
# 腿配对：apk 解出的 boot/vmlinuz-efi ≡ 现役 ESP BOOTAA64.EFI（逐字节）。
# 换新内核 = 连 ESP 一起换 nura 配对腿，并把 ESP_REF 指到新 ESP 镜像。
ESP_PAIR_SHA256="8b74582ba28b5c786acc327a5b531868707da494f5d4521641fa2f3493389504"
ESP_PAIR_SHA8="8b74582b"

# —— 固件（pmOS firmware-meizu-meizu20 包，含 qcom/sm8550 + ath12k/WCN7850）——
# r91 起 nura Release 固件改回 tarball 分发（.tar.gz；29c1ee88 = r72 时代原串，
# 顶层 lib/firmware/ 211 项与旧 apk 同构，内容同 1-r3 6e6dac0a）——变量名
# FIRMWARE_APK_* 沿用历史，build.sh 通配 .apk/.tar.gz 双吃，解包路径共用。
FIRMWARE_APK_VERSION="tarball-r72"
FIRMWARE_APK_SHA256="29c1ee8825b98281d130d6782cacbcd15f6100d879b4bd5b500995bcb5a507ec"

# —— 版号与料件门禁（2026-10-12 自适应口径）——
# OUR_VER = 我方镜像版号（与 nura 轮次解耦；发新版改这一处，产物名/Release tag 随动）
OUR_VER="r85"
# 料件三件（内核 apk / ESP gz / 固件包）由 workflow 动态解析 nura latest 下载，
# **sha 门禁是唯一安全底线**：nura 出新轮 → sha 失配 → 构建拦停 → 实机验证后
# 更新下列钉子再跑。URL 不硬编码。
ESP_IMG_SHA256="472cb934d8f653a4e7fede71e04736c7f461bdd1b048856a227ee2a93e60f11b"
# URL 直链（可选）：留空 = 不走 URL 拉取（CI 动态解析 nura latest；本机本地件优先）。
# 需要钉死某轮直拉时填完整 release download URL。
KERNEL_APK_URL=""
FIRMWARE_APK_URL=""
