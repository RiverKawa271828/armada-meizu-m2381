# kernel-m2381 — nura 线料件钉子（内核腿 + 固件，与 pmOS 线通用）
# 内核/固件 apk 由 nura 的 linux-meizu-meizu20 / firmware-meizu-meizu20 线出，
# **pmOS rootfs 与本 armada rootfs 通用同一套料件**——用户到 nura 侧拿最新版，
# 这里只钉当前验证版参数 + 兼容门禁，不编译不重分发。

# —— 内核腿（7.3.0-rc6 #81，现役验证版）——
KERNEL_APK_VERSION="r80"
KERNEL_RELEASE="7.3.0-rc6"
KERNEL_APK_SHA256="b0c865b7c921c53049d01e8afafac82d9dac2305217c418115674592231c0cdb"
# 腿配对：apk 解出的 boot/vmlinuz-efi ≡ 现役 ESP BOOTAA64.EFI（逐字节）。
# 换新内核 = 连 ESP 一起换 nura 配对腿，并把 ESP_REF 指到新 ESP 镜像。
ESP_PAIR_SHA256="12ee72b9ce6267627a6937645c19b911f3e7ba518a9d64210dfcaa31e63c6888"
ESP_PAIR_SHA8="12ee72b9"

# —— 固件（pmOS firmware-meizu-meizu20 apk，含 qcom/sm8550 + ath12k/WCN7850）——
FIRMWARE_APK_VERSION="1-r3"
FIRMWARE_APK_SHA256="f0018f565bd51997697677d1eb1029121c4745659a3a36e786cc3252a9098d27"

# —— 公开下载链接（待 nura 钉版 Release 后各补一行；留空 = 只认本地路径）——
KERNEL_APK_URL=""
FIRMWARE_APK_URL=""
