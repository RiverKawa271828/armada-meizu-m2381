# kernel-m2381 — nura 线料件钉子（内核腿 + 固件，与 pmOS 线通用）
# 内核/固件 apk 由 nura 的 linux-meizu-meizu20 / firmware-meizu-meizu20 线出，
# **pmOS rootfs 与本 armada rootfs 通用同一套料件**——用户到 nura 侧拿最新版，
# 这里只钉当前验证版参数 + 兼容门禁，不编译不重分发。

# —— 内核腿（7.3.0-rc6 #85，2026-10-12 nura 判过收官升现役）——
# r84/v65 B 路候选（2026-10-12 凌晨点火，nura 裁量判过 = GPU devfreq/IFPC 线收官）：
# ①钳零防御生效（真空闲 busy 恒 0，对照 r83 恒 6433）②governor 自愈（静态 UI 220
# 驻留 94.8%，GPU 温 39-41°C）③ifpc「ack 不执行」残线归档 lead（gen70200/v4.1.9
# ack SUCCESS 但 GX 不塌缩；追加轮弃权，复燃 = 用户点名 rebase 拼车）。
# 本轮三件 = revert A 路 clamp + busy 钳零（active_submits==0 报 0）+ IFPC payload
# 订阅。回滚配对 = r82/v63/#83（.r82-bak 在位，v63 裸镜像 work/ 在手）。
# r83 候选（apk r83/v64）冻结留档不追。
# 注意：r84 起候选件 = nura 本机构建产物直传（我方 dl/ 收档）；自 2026-10-12
# 起本仓 Release r84 直链分发 apk + ESP（云端构建料件），URL 见下段。
KERNEL_APK_VERSION="r84"
KERNEL_RELEASE="7.3.0-rc6"
KERNEL_APK_SHA256="b5dd7e62899638eb508bfc9d17b99052791bee1b40d50b7dc90d7ac280799a36"
# 腿配对：apk 解出的 boot/vmlinuz-efi ≡ 现役 ESP BOOTAA64.EFI（逐字节）。
# 换新内核 = 连 ESP 一起换 nura 配对腿，并把 ESP_REF 指到新 ESP 镜像。
ESP_PAIR_SHA256="01ddbb77181581b620fd180e4d85642b3a34511efa1a3d541c0e00bf7bb351af"
ESP_PAIR_SHA8="01ddbb77"

# —— 固件（pmOS firmware-meizu-meizu20 apk，含 qcom/sm8550 + ath12k/WCN7850）——
# sha = Release 下载件实测（6e6dac0a，nura 2026-10-11 深夜信）；nura 本地原始
# 打包为 f0018f56，同版本 1-r3 不同打包——以 Release 下载件为单一真值源。
FIRMWARE_APK_VERSION="1-r3"
FIRMWARE_APK_SHA256="6e6dac0a5a4dc7a4d95cfed3c0f0448493b2eef4a39940d9271a9c4ba8fe27f4"

# —— 版号与料件门禁（2026-10-12 自适应口径）——
# OUR_VER = 我方镜像版号（与 nura 轮次解耦；发新版改这一处，产物名/Release tag 随动）
OUR_VER="r84"
# 料件三件（内核 apk / ESP gz / 固件 apk）由 workflow 动态解析 nura latest 下载，
# **sha 门禁是唯一安全底线**：nura 出新轮 → sha 失配 → 构建拦停 → 实机验证后
# 更新下列钉子再跑。URL 不硬编码。
ESP_IMG_SHA256="463efc45b666da5284172d7ab328f75836fe6fb552509af0a8994b5af3b4b144"
# URL 直链（可选）：留空 = 不走 URL 拉取（CI 动态解析 nura latest；本机本地件优先）。
# 需要钉死某轮直拉时填完整 release download URL。
KERNEL_APK_URL=""
FIRMWARE_APK_URL=""
