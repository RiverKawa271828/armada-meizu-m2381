# kernel-m2381 — nura 线料件钉子（内核腿 + 固件，与 pmOS 线通用）
# 内核/固件 apk 由 nura 的 linux-meizu-meizu20 / firmware-meizu-meizu20 线出，
# **pmOS rootfs 与本 armada rootfs 通用同一套料件**——用户到 nura 侧拿最新版，
# 这里只钉当前验证版参数 + 兼容门禁，不编译不重分发。

# —— 内核腿（7.3.0-rc6 #82，2026-10-11 点火回归 PASS 升现役）——
# r82/v63 候选轮（busy−IFPC 折叠，#83）2026-10-11 深夜点火 = FAIL（ifpc_delta≡0 →
# 分型 H3，IFPC 未协商上）；r82 留机在役作实验腿（debugfs busy_deltas），钉子仍 r81。
# r83 候选（HFI 特性位考古）到后老流程再点火，过才更钉。
# r81 = config-only（+CONFIG_SQUASHFS_ZSTD/XZ=y；HCTOSYS/SYSTOHC → rtc1），
# fork tip 349e8aa5579b 不动。实机判定：uname #82 ✓ / zstd sqsh 直挂 ✓ /
# RTC 用户态持久化可撤（内核接管）✓。ESP 配对 v62。
KERNEL_APK_VERSION="r81"
KERNEL_RELEASE="7.3.0-rc6"
KERNEL_APK_SHA256="1c31babea76eefbd2b4f9c89fe2a665bc89ab1e34d6ffbe17fe8bd9e9534c310"
# 腿配对：apk 解出的 boot/vmlinuz-efi ≡ 现役 ESP BOOTAA64.EFI（逐字节）。
# 换新内核 = 连 ESP 一起换 nura 配对腿，并把 ESP_REF 指到新 ESP 镜像。
ESP_PAIR_SHA256="5cb94ebdca227485892f716305f8e0c8528905fd6a2ff89aa4944b4d65f9c213"
ESP_PAIR_SHA8="5cb94ebd"

