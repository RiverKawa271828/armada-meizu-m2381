#!/bin/bash
# steamos-gamescope-session v4（2026-10-10 点火成功版）—— gamescope standalone
# DRM backend + steam -gamepadui = 真 Deck 架构。手册 = docs/M2381-GAMESCOPE-IGNITION.md。
# 二进制 = master 自建（/usr/local/bin/gamescope，含 --force-composition-rotation）；
# Debian 3.16.22 无合成器旋转兜底，msm plane 只支持 0/180，竖屏面板必死，勿回退。
# 回退会话 = steamos-session（kwin，保留为 SDDM 会话项，黑屏逃生门）。
LOG=/tmp/steamos-gamescope-session.log
echo "=== steamos-gamescope-session v4 $(date -Is) pid $$ ===" >> "$LOG"
exec >> "$LOG" 2>&1
set -x
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/games
export XDG_CURRENT_DESKTOP=gamescope
# Vulkan 只挂 turnip（新旧两个 env 名都钉，防 lavapipe 抢枚举）
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/freedreno_icd.json
export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/freedreno_icd.json
export GAMESCOPE_FORCE_INTERNAL=1
# msm DPU 无 async/immediate flip 支持（DRM cap=0）——关掉，走 vblank 同步路径
# liftoff 布局失败缓存会把失败布局拉黑（保险丝，保留）
export GAMESCOPE_LIFTOFF_CACHE_DISABLE=1
# 残留 socket 清理（kwin 会话 / 上轮 gamescope 崩溃残留会让启动误判）
rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-0* \
      "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/gamescope-0* 2>/dev/null
mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

ATTEMPTS=0
while :; do
  ATTEMPTS=$((ATTEMPTS+1))
  echo "=== attempt $ATTEMPTS start $(date -Is) ==="
  START=$(date +%s)
  /usr/local/bin/gamescope \
    --backend drm \
    --force-composition-rotation \
    --force-orientation right \
    -W 1080 -H 2400 \
    -r 120 \
    --fullscreen \
    --xwayland-count 1 \
    -- /usr/bin/env WAYLAND_DISPLAY=gamescope-0 /usr/local/bin/steam-arm -gamepadui -steamos3
  RC=$?
  ELAPSED=$(( $(date +%s) - START ))
  echo "=== attempt $ATTEMPTS ended rc=$RC after ${ELAPSED}s $(date -Is) ==="
  if [ "$ELAPSED" -ge 15 ] || [ "$ATTEMPTS" -ge 5 ]; then
    exit "$RC"
  fi
  sleep 3
done
