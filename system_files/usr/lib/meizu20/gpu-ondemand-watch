#!/bin/bash
# 看护：simple_ondemand 被 GPU 重载打瞎（钉死最低档+零换档 30s）→ 重绑唤醒。
# ⚠ gpu-idle-damp 钳 220 时立 /run/sm20-gpu-idle/clamped 旗标——idle 冻结是本意，
# 见旗标直接让路，勿当病症重绑。
D=/sys/class/devfreq/3d00000.gpu
last_trans=""
stuck=0
while true; do
  if [ -f /run/sm20-gpu-idle/clamped ]; then
    sleep 5
    continue
  fi
  cur=$(cat $D/cur_freq 2>/dev/null)
  min=$(cat $D/min_freq 2>/dev/null)
  trans=$(awk "/^Total transition/{print \$3}" $D/trans_stat 2>/dev/null)
  if [ "$cur" = "$min" ] && [ -n "$trans" ] && [ "$trans" = "$last_trans" ]; then
    stuck=$((stuck+1))
  else
    stuck=0
  fi
  last_trans=$trans
  if [ "$stuck" -ge 6 ]; then
    echo simple_ondemand > $D/governor 2>/dev/null
    stuck=0
  fi
  sleep 5
done
